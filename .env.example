# Copy to .env and change the values:  copy .env.example .env

# Database
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Public port on your machine
HTTP_PORT=8080

# local | staging | production
WP_ENVIRONMENT_TYPE=local

# Site (used by scripts/setup)
SITE_URL=http://localhost:8080
SITE_TITLE="Saigon Table"
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin
ADMIN_EMAIL=admin@example.com

# Cloudflare (Phase 7, optional) - see docs/cloudflare.md
# When going public, also change SITE_URL to https://your.domain
CF_TUNNEL_TOKEN=
CF_ZONE_ID=
CF_API_TOKEN=
